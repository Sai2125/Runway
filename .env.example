# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=

# Gemini — extraction, friend voice, handwriting photos AND voice notes
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Only for a custom/proxied endpoint; leave empty for Google AI Studio
GEMINI_BASE_URL=

# Engine runs in run_web.py by default. Set RUN_ENGINE=1 here ONLY if you run
# run_telegram.py alone (never run the engine in both processes).
# RUN_ENGINE=1
# Engine tick seconds (60 for real life; 10 for demos)
ENGINE_INTERVAL_S=10
